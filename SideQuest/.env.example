# ==============================================================================
# SideQuest Production Environment Variables Template
# Copy this file to .env.local and populate the secrets.
# ==============================================================================

# Supabase (Database, Auth, Row Level Security, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Calendar Feed Token Secret / Hash Salt (Must be random min 32 chars)
CALENDAR_TOKEN_SALT=your-random-32-char-salt-string-for-hash

# Telegram Bot Alerts & Verified Webhook
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-secure-webhook-secret-min-16-chars

# Email Delivery (Resend / Brevo)
RESEND_API_KEY=re_your_api_key

# Optional AI Enrichment (Google Gemini API free tier)
GEMINI_API_KEY=your-gemini-api-key
ENABLE_AI_SUMMARIES=false

# App Canonical Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console Verification Token (GEO & Search indexing)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

# Rate Limiting & Sliding Window Controls (Optional override)
RATE_LIMIT_MAX_SUBMITS_PER_10M=5
RATE_LIMIT_MAX_READS_PER_MIN=60
